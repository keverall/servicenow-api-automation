# ---------------------------------------------------------------------------
# OpsRamp cloud API (https://api.opsramp.com/api)
# Create a "Custom" integration in Setup > Integrations to obtain a Key and a
# Secret.  OPSRAMP_API_KEY / OPSRAMP_API_SECRET are accepted as aliases.
# ---------------------------------------------------------------------------
OPSRAMP_BASE_URL=https://api.opsramp.com
OPSRAMP_TENANT_ID=client_00000000
OPSRAMP_CLIENT_ID=
OPSRAMP_CLIENT_SECRET=
OPSRAMP_SCOPE=global:manage
OPSRAMP_TIMEOUT_S=30
OPSRAMP_MAX_RETRIES=4
OPSRAMP_TOKEN_REFRESH_MARGIN_S=60

# ---------------------------------------------------------------------------
# Gateway appliance admin API (https://<gateway>:5480)
# ---------------------------------------------------------------------------
GATEWAY_HOST=10.0.0.10
GATEWAY_PORT=5480
GATEWAY_USERNAME=admin
GATEWAY_PASSWORD=
# OpsRamp API server URL shown next to the activation token in the OpsRamp UI.
GATEWAY_REGISTRATION_SERVER=
# Path to a PEM file holding the appliance CA certificate.
GATEWAY_CA_BUNDLE=
GATEWAY_VERIFY_TLS=true
GATEWAY_TIMEOUT_S=30
GATEWAY_MAX_RETRIES=3

# Only used by `opsramp-gw admin password change`.
GATEWAY_OLD_PASSWORD=
GATEWAY_NEW_PASSWORD=
GATEWAY_PROXY_PASSWORD=

# ---------------------------------------------------------------------------
# ServiceNow
# ---------------------------------------------------------------------------
SERVICENOW_INSTANCE=dev12345
SERVICENOW_TABLE=event
SERVICENOW_USERNAME=opsramp.integration
SERVICENOW_PASSWORD=
SERVICENOW_AUTH_MODE=basic
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_SYSPARM_LIMIT=100
SERVICENOW_MIN_INTERVAL_S=0
SERVICENOW_TIMEOUT_S=30
SERVICENOW_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Sync engine
# ---------------------------------------------------------------------------
SYNC_POLL_INTERVAL_S=300
SYNC_LOOKBACK_MINUTES=15
SYNC_STATE_PATH=.opsramp-sync/state.db
SYNC_DRY_RUN=true
SYNC_CLIENT_IDS=
SYNC_STATES=Critical,Warning,Ok
SYNC_CLOSE_ON_RECOVERY=true
SYNC_CI_LOOKUP=true
SYNC_MAPPING_FILE=config/mapping/event.yaml
SYNC_MAX_ATTEMPTS=3
SYNC_CACHE_TTL_MINUTES=60
SYNC_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
DEPLOY_PROFILE_NAME=opsramp-gateway
DEPLOY_DESCRIPTION=Managed by opsramp-automation
DEPLOY_PACKAGE_NAME=ova
DEPLOY_PROVISIONER=existing
DEPLOY_PACKAGE_DIR=.opsramp-sync/packages
DEPLOY_VERIFY_TIMEOUT_S=900
DEPLOY_VERIFY_INTERVAL_S=15
DEPLOY_DRY_RUN=false

# Desired network configuration of the appliance.
DEPLOY_HOSTNAME=
DEPLOY_DOMAIN=
DEPLOY_INTERFACE=
DEPLOY_IP_ADDRESS=
DEPLOY_SUBNET=
DEPLOY_NETWORK_GATEWAY=
DEPLOY_DNS=
DEPLOY_DHCP=false
DEPLOY_TIMEZONE=

# Comma separated lists.  Syslog receivers are plain host names; the port,
# protocol and selectors come from the appliance defaults (514/udp/*.*).
DEPLOY_NTP_SERVERS=
DEPLOY_SYSLOG_RECEIVERS=

DEPLOY_PROXY_CONNECTION=direct
DEPLOY_PROXY_IP=
DEPLOY_PROXY_PORT=
DEPLOY_PROXY_USER=
DEPLOY_PROXY_PASSWORD=

# ---------------------------------------------------------------------------
# vSphere provisioner (only used with DEPLOY_PROVISIONER=vsphere)
# ---------------------------------------------------------------------------
VSHERE_HOST=
VSHERE_USER=
VSHERE_PASSWORD=
VSHERE_DATACENTER=
VSHERE_DATASTORE=
VSHERE_NETWORK=
VSHERE_CLUSTER=
VSHERE_OVFTOOL_PATH=ovftool
VSHERE_INSECURE=true
VSHERE_GUEST_WAIT_S=900
