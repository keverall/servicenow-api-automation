# ---------------------------------------------------------------------------
# OpsRamp cloud API (https://api.opsramp.com/api)
# Create a "Custom" integration in Setup > Integrations to obtain Key/Secret.
# ---------------------------------------------------------------------------
OPSRAMP_BASE_URL=https://api.opsramp.com
OPSRAMP_TENANT_ID=client_00000000
OPSRAMP_API_KEY=
OPSRAMP_API_SECRET=
OPSRAMP_TIMEOUT_S=30
OPSRAMP_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# Gateway appliance admin API (https://<gateway>:5480)
# ---------------------------------------------------------------------------
GATEWAY_HOST=10.0.0.10
GATEWAY_PORT=5480
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=
# OpsRamp API server URL shown next to the activation token in the OpsRamp UI.
GATEWAY_REGISTRATION_SERVER=
# PEM bundle for the appliance's self-signed certificate.
GATEWAY_CA_BUNDLE=
GATEWAY_VERIFY_TLS=true

# ---------------------------------------------------------------------------
# ServiceNow
# ---------------------------------------------------------------------------
SERVICENOW_INSTANCE=dev12345
SERVICENOW_TABLE=event
SERVICENOW_USER=opsramp.integration
SERVICENOW_PASSWORD=
SERVICENOW_AUTH_MODE=basic
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_SYSPARM_LIMIT=100
SERVICENOW_MIN_INTERVAL_S=0

# ---------------------------------------------------------------------------
# Sync engine
# ---------------------------------------------------------------------------
SYNC_POLL_INTERVAL_S=300
SYNC_LOOKBACK_MINUTES=15
SYNC_STATE_PATH=.opsramp-sync/state.db
SYNC_DRY_RUN=true
SYNC_CLIENT_IDS=
SYNC_STATES=CRITICAL,WARNING
SYNC_CLOSE_ON_RECOVERY=true
SYNC_CI_LOOKUP=true
SYNC_MAPPING_FILE=config/mapping/event.yaml
SYNC_MAX_ATTEMPTS=3
SYNC_MAX_FAILURES=0

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
DEPLOY_PROFILE_NAME=opsramp-gateway
DEPLOY_PACKAGE_NAME=ova
DEPLOY_PROVISIONER=existing
DEPLOY_OVFTOOL_PATH=ovftool
DEPLOY_VSPHERE_HOST=
DEPLOY_VSPHERE_USER=
DEPLOY_VSPHERE_PASSWORD=
DEPLOY_VSPHERE_DATACENTER=
DEPLOY_VSPHERE_DATASTORE=
DEPLOY_VSPHERE_NETWORK=
DEPLOY_VSPHERE_CLUSTER=
DEPLOY_VSPHERE_VM_NAME=
DEPLOY_REGISTRATION_TIMEOUT_S=900
